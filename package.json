{
  "name": "tni-rater-autofill",
  "version": "0.9.19",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "description": "Chrome extension that fills Progressive and GEICO rater pages from a TNI quote application PDF",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "server": "node server/index.mjs",
    "learn": "node scripts/learn-rules.mjs server-data",
    "layouts": "node scripts/build-layouts.mjs server-data",
    "transitions": "node scripts/transitions.mjs server-data",
    "captures": "node scripts/captures.mjs layouts",
    "summary": "node scripts/summarize-usage.mjs server-data",
    "signals": "node scripts/weekly-signals.mjs server-data",
    "ledger": "node scripts/ledger.mjs",
    "replay": "node scripts/replay.mjs",
    "bakeoff:score": "node scripts/bakeoff-score.mjs test/bakeoff/answer-key.json",
    "package": "node scripts/package.mjs",
    "review": "node scripts/review.mjs server-data",
    "e2e": "node scripts/e2e.mjs",
    "mock:amwins": "node scripts/amwins-mock.mjs",
    "mock:geico": "node scripts/geico-mock.mjs",
    "test:intakes": "node scripts/intake-mocks.mjs",
    "mock:luna": "node scripts/luna-mock.mjs",
    "ai:eval": "node scripts/ai-eval.mjs",
    "e2e:extension": "node scripts/extension-e2e.mjs",
    "ci": "node scripts/ci-local.mjs",
    "pull": "node scripts/logs-pull.mjs",
    "daily": "node scripts/daily.mjs",
    "push-logs": "node scripts/logs-push.mjs",
    "coverage": "node scripts/coverage.mjs server-data",
    "benchmark": "node scripts/benchmark.mjs server-data",
    "key:sheet": "node scripts/answer-key-sheet.mjs server-data",
    "fixtures:progressive": "node scripts/refresh-fixtures.mjs"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.63.0"
  }
}
