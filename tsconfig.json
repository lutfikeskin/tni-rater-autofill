{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "lib": ["DOM", "ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["chrome"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["background.js", "types.js", "vite.config.js", "vitest.config.js", "src", "sidepanel", "server", "scripts", "test"]
}
