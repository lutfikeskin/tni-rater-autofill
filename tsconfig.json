{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "lib": ["DOM", "ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["chrome"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["background.js", "types.js", "src", "sidepanel"]
}
