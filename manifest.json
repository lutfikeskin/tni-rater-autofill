{
  "manifest_version": 3,
  "name": "TNI Rater Autofill",
  "version": "0.9.7",
  "description": "Fills Progressive, AmWINS and GEICO quotes from a TNI quote application PDF, with AI tips for questions left to the agent.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.foragentsonly.com/*",
    "https://*.progressive.com/*",
    "https://*.geico.com/*",
    "https://*.amwinsadmittedplacement.com/*",
    "https://api.openai.com/*",
    "https://usage-server-production.up.railway.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Rater Autofill",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
