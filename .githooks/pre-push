#!/bin/sh
# Before a push, runs this repository's pull-request checks on this computer (`npm run ci`,
# scripts/ci-local.mjs), since GitHub's minutes are paid. `npm ci` / `npm install` installs it:
# the prepare script points core.hooksPath at .githooks.
#
#   git push                -> npm run ci -- --quick (lint, type check, unit tests, package)
#   TNI_CI=full git push    -> npm run ci (adds the packaged-extension E2E and the mocks)
#   git push --no-verify    -> no checks; say so wherever the push is reported
#
# Skipped when `npm run ci` already passed on HEAD with no uncommitted changes to tracked files
# (a full pass covers a quick push). The checks run on the working tree, so a push of a commit
# other than HEAD is refused: check that branch out, or push it with --no-verify.

mode=${TNI_CI:-quick}
head=$(git rev-parse HEAD)
dirty=$(git status --porcelain --untracked-files=no)

# Each stdin line: <local ref> <local sha> <remote ref> <remote sha>; a deletion's local sha is zeros.
while read -r _ sha _ _; do
  case $sha in
    *[!0]*)
      if [ "$sha" != "$head" ]; then
        echo "pre-push: $sha is not HEAD ($head), and the checks run on HEAD's working tree." >&2
        echo "pre-push: check that commit out and push again, or push with --no-verify and say it is unchecked." >&2
        exit 1
      fi ;;
  esac
done

passed=$(cat "$(git rev-parse --git-path tni-ci-passed)" 2>/dev/null)
if [ -z "$dirty" ] && { [ "$passed" = "$head full" ] || { [ "$mode" != full ] && [ "$passed" = "$head quick" ]; }; }; then
  echo "pre-push: npm run ci already passed on $head (${passed#* }); not running it again."
  exit 0
fi

if [ -n "$dirty" ]; then
  echo "pre-push: tracked files have uncommitted changes; the checks run on them too, not only on what is pushed."
fi
# git runs this hook with GIT_DIR set (an absolute path when the push comes from a linked worktree),
# and with it set, a git command the checks run in a temporary folder acts on this repository
# instead: the ledger tests' `git init` set core.bare = true in the shared .git/config on 2026-10-27.
# Without git's per-repository variables, the checks find their repository from their folder, as
# they do outside a push.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
if [ "$mode" = full ]; then npm run ci; else npm run ci -- --quick; fi
