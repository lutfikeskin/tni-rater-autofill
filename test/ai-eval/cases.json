{
  "version": 1,
  "description": "Synthetic provider comparison cases for bounded carrier-answer suggestions.",
  "cases": [
    {
      "id": "missing-vs-explicit-no",
      "rationale": "A missing intake fact must remain unresolved, while an explicit false value may support No under the written rule.",
      "context": {
        "carrier": "progressive",
        "page": "CoveragesRates",
        "record": {
          "applicant": { "name": "Synthetic Hauling LLC" },
          "operations": { "businessClass": "Expediter" },
          "garaging": { "state": "TX", "zip": "75001" },
          "coverage": { "reeferBreakdown": false },
          "drivers": [{ "first": "Alex", "last": "Driver" }],
          "vehicles": [{ "type": "Cargo Van", "value": 24000 }]
        },
        "active": { "drivers": 0, "vehicles": 0 }
      },
      "items": [
        {
          "key": "hazardous-material-placard",
          "question": "Does this vehicle require a hazardous material placard?",
          "label": "Hazardous material placard",
          "section": "More about the business",
          "controlKind": "radio",
          "options": ["Yes", "No"],
          "current": "No"
        },
        {
          "key": "reefer-breakdown",
          "question": "Refrigeration Breakdown",
          "label": "Refrigeration Breakdown",
          "section": "Coverages and rates",
          "controlKind": "radio",
          "options": ["Yes", "No"],
          "current": "Yes"
        }
      ],
      "expected": [
        { "key": "hazardous-material-placard", "choice": null, "basis": "none" },
        { "key": "reefer-breakdown", "choice": "No", "basis": "intake", "intakePath": "coverage.reeferBreakdown" }
      ],
      "expertReviewed": false
    },
    {
      "id": "ambiguous-notes",
      "rationale": "A vague note about possible hazardous materials does not establish a binary answer.",
      "context": {
        "carrier": "amwins",
        "page": "Underwriting",
        "record": {
          "applicant": { "name": "Synthetic Freight LLC" },
          "operations": { "businessClass": "General freight" },
          "garaging": { "state": "OH", "zip": "43004" },
          "coverage": {},
          "claims": { "notes": "May occasionally carry regulated materials; confirm with agent." },
          "drivers": [{ "first": "Taylor", "last": "Driver" }],
          "vehicles": [{ "type": "Box Truck" }]
        },
        "active": { "drivers": 0, "vehicles": 0 }
      },
      "items": [
        {
          "key": "hazmat-operations",
          "question": "Does the business haul hazardous materials?",
          "label": "Hazardous materials",
          "section": "Underwriting questions",
          "controlKind": "select",
          "options": ["Yes", "No"],
          "current": "No"
        }
      ],
      "expected": [{ "key": "hazmat-operations", "choice": null, "basis": "none" }],
      "expertReviewed": false
    },
    {
      "id": "conflicting-evidence",
      "rationale": "Direct structured evidence and a contradictory note cannot safely settle the field.",
      "context": {
        "carrier": "progressive",
        "page": "MoreAboutBusiness",
        "record": {
          "applicant": { "name": "Synthetic Carrier LLC" },
          "operations": {
            "businessClass": "Expediter",
            "hazPlacard": true
          },
          "garaging": { "state": "IN", "zip": "46204" },
          "coverage": {},
          "claims": { "notes": "Owner says no placard is used. Needs agent confirmation." },
          "drivers": [{ "first": "Jordan", "last": "Driver" }],
          "vehicles": [{ "type": "Cargo Van" }]
        },
        "active": { "drivers": 0, "vehicles": 0 }
      },
      "items": [
        {
          "key": "hazardous-material-placard",
          "question": "Hazardous material placard required?",
          "label": "Hazardous material placard",
          "section": "More about the business",
          "controlKind": "checkbox",
          "options": ["checked", "unchecked"],
          "current": "unchecked"
        }
      ],
      "expected": [{ "key": "hazardous-material-placard", "choice": null, "basis": "none" }],
      "expertReviewed": false
    },
    {
      "id": "unsupported-coverage-default",
      "rationale": "A page default cannot establish an omitted coverage request, and the rule leaves this decision to the agent.",
