        "carrier": "progressive",
        "page": "PaymentAndPrinting",
        "record": {
          "applicant": { "name": "Synthetic Safety LLC" },
          "operations": { "businessClass": "Expediter" },
          "garaging": { "state": "MD", "zip": "20814" },
          "coverage": {},
          "drivers": [{ "first": "Casey", "last": "Driver" }],
          "vehicles": [{ "type": "Cargo Van" }]
        },
        "active": { "drivers": 0, "vehicles": 0 }
      },
      "items": [
        {
          "key": "order-mvr",
          "question": "Order the motor vehicle record?",
          "label": "Order MVR report",
          "section": "Reports",
          "controlKind": "radio",
          "options": ["Yes", "No"],
          "current": "No"
        },
        {
          "key": "declaration",
          "question": "I declare that the information provided is true and complete.",
          "label": "I declare that the information is true and complete",
          "section": "Declaration",
          "controlKind": "radio",
          "options": ["I agree", "I do not agree"],
          "current": "I do not agree"
